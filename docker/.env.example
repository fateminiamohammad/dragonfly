# Copy to docker/.env and fill in. Never commit .env files.
#   development: .env   production: .prod.env (ENV_FILE_NAME=.prod.env)

# ---- model-service ----
# Checkpoint directory (inside the container, ./runs is mounted at /runs), e.g. /runs/dragonfly-s or /runs/dragonfly-m.
# Untrained heads (answers meaningless, for wiring tests): base:<encoder hub id> (tier S), base-m:<decoder hub id> (tier M).
DRAGONFLY_CHECKPOINT=base:answerdotai/ModernBERT-base
# Optional tier M checkpoint: enables the S -> M cascade for questions S is unsure about.
DRAGONFLY_CHECKPOINT_M=
DRAGONFLY_CASCADE_THRESHOLD=0.8
# cuda | cpu (empty = cuda when available)
DRAGONFLY_DEVICE=
# 1 = torch.compile the models: slower start, faster steady state
DRAGONFLY_COMPILE=0
DRAGONFLY_CACHE_SIZE=4096
DRAGONFLY_MAX_BATCH=64
DRAGONFLY_LOG_LEVEL=INFO
# Static bearer keys for /v1 (comma separated). Keys created in the UI are shared through Redis and need no entry here.
# MODEL_SERVICE_API_KEY below must be listed here so the backend's playground can call the model.
DRAGONFLY_API_KEYS=change-me-internal-playground-key

# ---- plugins ----
# Comma-separated plugin names to load (installed packages exposing the dragonfly.plugins entry point).
DRAGONFLY_PLUGINS=
# Out-of-process plugins (gRPC sidecars, any language): name@host:port, comma separated.
# Example: DRAGONFLY_GRPC_PLUGINS=policy@plugin-policy:50051 (run with --profile plugins)
DRAGONFLY_GRPC_PLUGINS=
# Answers below this confidence go through each plugin's on_low_confidence hook (0 = off).
DRAGONFLY_LOW_CONFIDENCE=0
# Per-plugin settings: DRAGONFLY_PLUGIN_<NAME>_<KEY>=value, e.g. DRAGONFLY_PLUGIN_REDACT_PII_MASK=[hidden]

# ---- backend ----
POSTGRES_USER=dragonfly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dragonfly
DB_PORT=5432
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# First admin, created once when the database has no users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
MODEL_SERVICE_API_KEY=change-me-internal-playground-key
CORS_ORIGINS=

# ---- benchmark vs LLMs (bench profile) ----
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
DRAGONFLY_API_KEY=change-me-internal-playground-key

# ---- ports / images / edge ----
MODEL_SERVICE_PORT=8000
EDGE_PORT=8080
MODEL_IMAGE=ghcr.io/OWNER/dragonfly-model-service:latest
BACKEND_IMAGE=ghcr.io/OWNER/dragonfly-backend:latest
UI_IMAGE=ghcr.io/OWNER/dragonfly-ui:latest
APP_DOMAIN=dragonfly.example.com
# PyTorch build baked into the model-service image: cu126 (NVIDIA GPU) or https://download.pytorch.org/whl/cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
