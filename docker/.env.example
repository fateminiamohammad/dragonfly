# Copy to docker/.env and fill in. Never commit .env files.
#   development: .env   production: .prod.env (ENV_FILE_NAME=.prod.env)

# ---- model-service ----
# Checkpoint directory (inside the container, ./runs is mounted at /runs), e.g. /runs/dragonfly-s or /runs/dragonfly-m.
# Untrained heads (answers meaningless, for wiring tests): base:<encoder hub id> (tier S), base-m:<decoder hub id> (tier M).
DRAGONFLY_CHECKPOINT=base:answerdotai/ModernBERT-base
# Optional tier M checkpoint: enables the S -> M cascade for questions S is unsure about.
DRAGONFLY_CHECKPOINT_M=
# tuned on the calibration split with scripts/tune_cascade.py (0.45 for dragonfly-s-distilled + dragonfly-m;
# 0.20 = fast: 14% escalated, 72.2% test)
DRAGONFLY_CASCADE_THRESHOLD=0.45
# cuda | cpu (empty = cuda when available)
DRAGONFLY_DEVICE=
# 1 = torch.compile the models: slower start, faster steady state
DRAGONFLY_COMPILE=0
DRAGONFLY_CACHE_SIZE=4096
DRAGONFLY_MAX_BATCH=64
DRAGONFLY_LOG_LEVEL=INFO
# Static bearer keys for /v1 (comma separated). Keys created in the UI are shared through Redis and need no entry here.
# MODEL_SERVICE_API_KEY below must be listed here so the backend's playground can call the model.
DRAGONFLY_API_KEYS=change-me-internal-playground-key

# Risk table for "max_error" in requests (scripts/fit_risk.py; docs/API.md#risk-controlled-answers-max_error)
DRAGONFLY_RISK=

# ---- swarm: specialist dragonflies (docs/SWARM.md) ----
# Folder of specialists (each <name>/ has a checkpoint + specialist.json). Requests pick one with "model": "<name>",
# or "model": "auto" to let the general tier S route. Empty = no swarm.
DRAGONFLY_SPECIALISTS=/runs/specialists
# tier S specialists kept in VRAM at once (least recently used are unloaded)
DRAGONFLY_SWARM_MAX_LOADED=4
# "auto" routes to a specialist only above this router confidence, otherwise the general model answers
DRAGONFLY_ROUTE_THRESHOLD=0.5
# trainer-worker (UI "Specialists" training): warm-start checkpoints (default: the served ones), tier M jobs need a
# free GPU (a second one, or tier M serving stopped), tokens per row and batch size while training
DRAGONFLY_INIT_S=
DRAGONFLY_INIT_M=
DRAGONFLY_TRAIN_M=0
DRAGONFLY_TRAIN_MAX_LENGTH=512
DRAGONFLY_TRAIN_BATCH=16

# ---- perception-service: images and audio -> text (non-autoregressive) ----
# model-service calls it at this URL (set empty to disable images/audio).
PERCEPTION_URL=http://perception-service:8001
# speech models per language (CTC). en: parakeet-ctc-0.6b (CC-BY-4.0); fa: wav2vec2-xlsr-53-persian (Apache-2.0)
PERCEPTION_ASR_MODEL_EN=nvidia/parakeet-ctc-0.6b
PERCEPTION_ASR_MODEL_FA=jonatasgrosman/wav2vec2-large-xlsr-53-persian
# more languages: PERCEPTION_ASR_MODELS=de=org/model,ar=org/model
PERCEPTION_ASR_MODELS=
PERCEPTION_TAGS_MODEL=google/siglip2-base-patch16-224
# your own tag vocabulary (one per line); empty = built-in
PERCEPTION_TAGS_FILE=
# OCR recognition models allowed: en, arabic (Persian/Arabic/Urdu), latin, ch, cyrillic, ...
PERCEPTION_OCR_LANGS=en,arabic
PERCEPTION_PRELOAD=tags,ocr:en,asr:en
PERCEPTION_MAX_MB=20
PERCEPTION_MAX_AUDIO_S=60

# ---- plugins ----
# Comma-separated plugin names to load (installed packages exposing the dragonfly.plugins entry point).
DRAGONFLY_PLUGINS=
# Out-of-process plugins (gRPC sidecars, any language): name@host:port, comma separated.
# Example: DRAGONFLY_GRPC_PLUGINS=policy@plugin-policy:50051 (run with --profile plugins)
DRAGONFLY_GRPC_PLUGINS=
# Answers below this confidence go through each plugin's on_low_confidence hook (0 = off).
DRAGONFLY_LOW_CONFIDENCE=0
# Per-plugin settings: DRAGONFLY_PLUGIN_<NAME>_<KEY>=value, e.g. DRAGONFLY_PLUGIN_REDACT_PII_MASK=[hidden]
#
# Free built-in plugins (docs/PLUGINS.md#free-plugins), enable any of them by name, e.g.
#   DRAGONFLY_PLUGINS=guardrails,human-review,webhook-audit,llm-escalation
#   DRAGONFLY_LOW_CONFIDENCE=0.5            # llm-escalation and human-review act below this confidence
# guardrails: PII redaction and injection/profanity checks before the model
#   DRAGONFLY_PLUGIN_GUARDRAILS_PII=redact              # redact | off
#   DRAGONFLY_PLUGIN_GUARDRAILS_INJECTION=flag          # flag | block | off
#   DRAGONFLY_PLUGIN_GUARDRAILS_MAX_STATE_CHARS=100000
# human-review: unsure decisions go to the UI Review page (uses REDIS_URL)
#   DRAGONFLY_PLUGIN_HUMAN_REVIEW_SAMPLE=1.0
# webhook-audit: send decisions to a webhook, Slack or a JSONL file, optionally filtered
#   DRAGONFLY_PLUGIN_WEBHOOK_AUDIT_URL=https://example.com/hook
#   DRAGONFLY_PLUGIN_WEBHOOK_AUDIT_WHEN=urgent.noul>0.8 or intent.choice==refund
# llm-escalation: ask an OpenAI-compatible LLM when Dragonfly is unsure (run with --profile llm for Ollama)
#   DRAGONFLY_PLUGIN_LLM_ESCALATION_BASE_URL=http://llm:11434/v1
#   DRAGONFLY_PLUGIN_LLM_ESCALATION_MODEL=qwen2.5:7b-instruct

# ---- backend ----
POSTGRES_USER=dragonfly
POSTGRES_PASSWORD=change-me
POSTGRES_DB=dragonfly
DB_PORT=5432
# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# First admin, created once when the database has no users.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please
MODEL_SERVICE_API_KEY=change-me-internal-playground-key
CORS_ORIGINS=

# ---- benchmark vs LLMs (bench profile) ----
# Hosted API (OpenAI, Anthropic's OpenAI-compatible endpoint, ...) or the local `llm` profile:
#   LLM_BASE_URL=http://llm:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
DRAGONFLY_API_KEY=change-me-internal-playground-key

# ---- ports / images / edge ----
MODEL_SERVICE_PORT=8000
EDGE_PORT=8080
MODEL_IMAGE=ghcr.io/OWNER/dragonfly-model-service:latest
BACKEND_IMAGE=ghcr.io/OWNER/dragonfly-backend:latest
UI_IMAGE=ghcr.io/OWNER/dragonfly-ui:latest
PERCEPTION_IMAGE=ghcr.io/OWNER/dragonfly-perception-service:latest
APP_DOMAIN=dragonfly.example.com
# PyTorch build baked into the model-service image: cu126 (NVIDIA GPU) or https://download.pytorch.org/whl/cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
